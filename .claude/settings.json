{
  "permissions": {
    "allow": [
      "Bash(bash run.sh)",
      "Bash(bash test.sh)",
      "Bash(javac *)",
      "Bash(java -version)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git push origin *)",
      "Bash(git tag *)",
      "Bash(gh auth status)",
      "Bash(gh repo view*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git checkout -- *)",
      "Bash(rm -rf *)",
      "Bash(gh repo delete*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/fresh-chat-reminder.sh\" after-commit"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/fresh-chat-reminder.sh\" prompt-count"
          }
        ]
      }
    ]
  }
}
